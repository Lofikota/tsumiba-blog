---
// 2026-07-26 ASP-V02: 3社カードの送客先（/go/dmm-fx, /go/jfx, /go/fxtf）は
// すべて不可用だった（jfx/fxtfはafi-bの404、dmm-fxは現行サイトで未提携かつ申請停止判定済み）。
// 「押しても報酬が発生しない外部リンク」を全記事から出し続けていたため、
// 送客CTAから自サイト内の比較・レビュー記事へ送る情報CTAへ役割を変更した。
// 提携が成立したら、各hrefを /go/<slug>/ へ戻し data-google-category を affiliate に戻す。
interface Props {
  heading?: string;
  lead?: string;
}

const {
  heading = '口座を決める前に、比較の判断軸を確認する',
  lead = '国内FX口座は「最低取引単位」「スプレッド」「取引ツール」で選びます。まず比較記事で判断軸を押さえてから、気になる会社の詳細を確認してください。',
} = Astro.props;

const reviews = [
  { href: '/blog/jfx-review/', name: 'JFX', label: 'fx-compare-jfx', note: 'MT4はチャート分析専用で、発注・EAは不可。注文とポジション管理はMATRIX TRADERを使用。' },
  { href: '/blog/fxtf-review/', name: 'FXTF', label: 'fx-compare-fxtf', note: '最低1,000通貨から取引可能。口座・通貨ペアごとのスプレッドや手数料を確認。' },
  { href: '/blog/dmm-fx-review/', name: 'DMM FX', label: 'fx-compare-dmm-fx', note: 'FX取引高4年連続世界第1位（ファイナンス・マグネイト社調べ 2022〜2025年）。' },
];
---

<section class="fx-priority" aria-label="FX口座の比較導線">
  <p class="fx-priority-kicker">PR</p>
  <h2>{heading}</h2>
  <p class="fx-priority-lead">{lead}</p>
  <a href="/blog/fx-kouza-hikaku/" class="fx-priority-card fx-priority-main fx-priority-hero" data-google-event="article_cta_click" data-google-category="internal_nav" data-google-label="fx-compare-hub">
    <strong>FX口座の比較条件をまとめて確認する</strong>
    <small>スプレッド・最低取引単位・ツールを一覧で比較。少額から始める人が最初に読む記事です。</small>
  </a>
  <div class="fx-priority-grid">
    {reviews.map((r) => (
      <a href={r.href} class="fx-priority-card" data-google-event="article_cta_click" data-google-category="internal_nav" data-google-label={r.label}>
        <strong>{r.name}</strong>
        <small>{r.note}</small>
      </a>
    ))}
  </div>
  <p class="fx-priority-note">FXは元本割れや預け入れた資金を上回る損失が発生するリスクがあります。申込前に必ず公式条件を確認してください。</p>
</section>

<style>
  .fx-priority {
    margin: 1.75rem 0 2rem;
    padding: 18px;
    border: 1px solid #E5E7EB;
    border-left: 3px solid #E0A458;
    border-radius: 10px;
    background: #fff;
  }
  .fx-priority-kicker {
    margin: 0 0 6px;
    color: #1B3A5B;
    font-size: 12px;
    font-weight: 800;
  }
  .fx-priority h2 {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.45;
  }
  .fx-priority-lead {
    margin: 0 0 14px;
    color: #334155;
    font-size: 14px;
    line-height: 1.8;
  }
  .fx-priority-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .fx-priority-grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .fx-priority-card {
    display: grid;
    gap: 6px;
    align-content: start;
    min-height: 112px;
    padding: 13px;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background: #fff;
    color: #1F2937;
    text-decoration: none;
  }
  .fx-priority-main {
    border-color: #1B3A5B;
    box-shadow: 0 8px 22px rgba(27, 58, 91, 0.14);
  }
  .fx-priority-muted {
    background: #f8fafc;
  }
  .fx-priority-hero {
    min-height: 0;
    margin-bottom: 10px;
    background: #f8fafc;
  }
  .fx-priority-hero strong {
    font-size: 16px;
  }
  .fx-priority-card strong {
    font-size: 15px;
  }
  .fx-priority-card small {
    color: #475569;
    font-size: 12px;
    line-height: 1.6;
  }
  .fx-priority-note {
    margin: 12px 0 0;
    color: #64748b;
    font-size: 12px;
    line-height: 1.7;
  }
  @media (max-width: 720px) {
    .fx-priority-grid,
    .fx-priority-grid-2 {
      grid-template-columns: 1fr;
    }
    .fx-priority-card {
      min-height: auto;
    }
  }
</style>
