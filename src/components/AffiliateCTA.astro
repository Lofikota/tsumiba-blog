---
import { resolveAffiliateTarget } from '../data/affiliateLinks';

interface Props {
  href?: string;
  product?: string;
  text: string;
  label?: string;
  color?: 'blue' | 'green' | 'orange' | 'red';
  note?: string;
  badge?: string;
  compact?: boolean;
  external?: boolean;
  /**
   * 成果リンクを有効化する配置ID（例: "fxtf-zero-spread:fee"）。
   * affiliateLinks.ts の allowlist に載っている値を渡した時だけ外部送客になる。
   * 未指定・allowlist外は、案件が提携済みでも内部導線のまま（BIZ-FIX-ASP01 §3-2B）。
   */
  placement?: string;
}

const { href, product, text = '公式サイトで確認する', label = 'PR', color = 'blue', note, badge, compact = false, external = true, placement } = Astro.props;
// 2026-07-26 ASP-V02: 提携未成立（status:'pending'）の案件は「公式サイトで〜」と書いてある
// ボタンを押しても報酬が発生せず、遷移先も自サイト内になる。文言とリンク属性が実態と食い違うため、
// pending時はCTAラベル・rel・計測カテゴリをまとめて内部導線として扱う。
// 提携が成立したら affiliateLinks.ts の status を 'affiliate' に戻すだけで元の文言・送客に復帰する。
// mdx側には product="jfx" 形式と href="/go/jfx/" 直書き形式の両方があるため、どちらもslugへ正規化する。
const slugFromHref = href?.match(/^\/go\/([a-z0-9-]+)\/?$/)?.[1];
const targetSlug = product ?? slugFromHref;
const resolved = targetSlug ? resolveAffiliateTarget(targetSlug, placement) : null;
const isPendingTarget = resolved?.isPending ?? false;
const ctaHref = resolved ? resolved.href : href ?? '#';
const ctaText = isPendingTarget ? resolved!.fallbackText : text;
// 成果CTAは配置IDをそのままGA4ラベルにする（掲載位置別に確定EPCを出すため。FXTF広告改善案 §計測）。
const ctaLabel = isPendingTarget ? `${targetSlug}:fallback` : placement ?? targetSlug ?? href ?? text;
// 内部導線へ倒した結果、比較記事そのものの上でCTAが自分自身を指す（＝行き止まり）ケースが出る。
// その場合はFX口座ランキング一覧へ送る。
const selfLink = ctaHref === Astro.url.pathname;
const finalHref = selfLink ? '/fx/' : ctaHref;
const finalText = selfLink ? 'FX口座ランキングで比較する（PR）' : ctaText;
const isExternalLink = external && !isPendingTarget && !finalHref.startsWith('/');

// CTAボタンは tsumiba の琥珀(#E0A458)に統一（color指定は受け取るが琥珀に正規化）
const colorMap: Record<string, string> = {
  blue:   'background:#E0A458;',
  green:  'background:#E0A458;',
  orange: 'background:#E0A458;',
  red:    'background:#E0A458;',
};
const bg = colorMap[color] ?? colorMap.blue;
---

<div class={`acta-wrap${compact ? ' acta-wrap-compact' : ''}`}>
  {badge && <div class={`acta-badge${compact ? ' acta-badge-compact' : ''}`}>{badge}</div>}
  {note && <p class={`acta-note${compact ? ' acta-note-compact' : ''}`}>{note}</p>}
  <a href={finalHref} {...(isExternalLink ? { target: '_blank', rel: 'noopener noreferrer sponsored nofollow' } : {})}
     data-google-event="article_cta_click"
     data-google-category={isPendingTarget ? 'internal_nav' : 'affiliate'}
     data-google-label={ctaLabel}
     class={`acta-btn${compact ? ' acta-btn-compact' : ''}`} style={bg}>
    <span class="acta-arrow">→</span>
    {finalText}
  </a>
  <p class={`acta-sub${compact ? ' acta-sub-compact' : ''}`}><span class={`acta-pr${compact ? ' acta-pr-compact' : ''}`}>{label}</span> {isPendingTarget ? 'サイト内の比較ページへ移動します' : '公式サイトへ移動します'}</p>
</div>

<style>
.acta-wrap {
  margin: 2rem 0;
  text-align: center;
  background: #f9fafb;
  border: 1.5px solid #d1d5db;
  border-radius: 14px;
  padding: 24px 24px 18px;
  box-shadow: 0 2px 12px rgba(0,0,0,.07);
}
.acta-wrap-compact {
  margin: 1rem 0;
  padding: 18px 18px 14px;
}
.acta-badge {
  display: inline-block;
  background: #1e293b; color: #fff;
  font-size: 11px; font-weight: 700;
  padding: 3px 12px; border-radius: 999px;
  margin-bottom: 12px; letter-spacing: .05em;
}
.acta-badge-compact {
  margin-bottom: 8px;
}
.acta-note {
  font-size: 13px; color: #374151;
  margin-bottom: 16px; line-height: 1.7;
}
.acta-note-compact {
  font-size: 12px;
  margin-bottom: 10px;
}
.acta-btn {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  width: 100%;
  color: #fff; font-size: 17px; font-weight: 800;
  padding: 17px 24px; border-radius: 10px;
  text-decoration: none; letter-spacing: .03em;
  transition: filter .15s, transform .1s;
  box-shadow: 0 4px 16px rgba(0,0,0,.2);
}
.acta-btn-compact {
  font-size: 15px;
  padding: 14px 18px;
}
.acta-btn:hover { filter: brightness(1.08); transform: translateY(-2px); }
.acta-arrow { font-size: 20px; }
.acta-sub {
  font-size: 11px; color: #6B7280;
  margin-top: 12px;
}
.acta-sub-compact {
  margin-top: 8px;
}
.acta-pr {
  background: #e5e7eb; color: #374151;
  font-size: 10px; font-weight: 700;
  padding: 1px 6px; border-radius: 3px;
  margin-right: 4px;
}
.acta-pr-compact { font-size: 9px; }
</style>
